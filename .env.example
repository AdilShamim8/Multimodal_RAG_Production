# =========================================================================
# Multimodal RAG Production — Environment Template
# Copy to `.env` and edit. All values are optional; sensible defaults apply.
# =========================================================================

# --- App ---
APP_NAME=multimodal-rag
APP_ENV=dev                      # dev | staging | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
APP_WORKERS=1                    # uvicorn workers (prod: #CPUs)

# --- Providers -------------------------------------------------------------
# Each provider accepts: mock | local_hf | openai
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=mock
GENERATOR_PROVIDER=mock

# HuggingFace model IDs (used only when provider=local_hf)
EMBEDDING_MODEL_ID=nvidia/Nemotron-Embed-VL
RERANKER_MODEL_ID=nvidia/Llama-Nemotron-Rerank-VL
GENERATOR_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct

# Device: auto | cpu | cuda | mps
MODEL_DEVICE=auto
MODEL_TORCH_DTYPE=auto           # auto | float32 | float16 | bfloat16

# OpenAI (used only when provider=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_RERANKER_MODEL=gpt-4o-mini
OPENAI_GENERATOR_MODEL=gpt-4o-mini

# HuggingFace Hub token (optional; needed for some gated models)
HF_TOKEN=

# --- Vector Store ----------------------------------------------------------
VECTOR_STORE=chroma             # chroma | qdrant | faiss

# Chroma (embedded)
CHROMA_PERSIST_DIR=./data/chroma

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=recipes

# FAISS (in-memory + optional disk index)
FAISS_INDEX_PATH=./data/faiss/index.faiss

# --- Dataset ---------------------------------------------------------------
DATASET_SOURCE=sample           # sample | hf | local
DATASET_HF_ID=mrdbourke/recipe-synthetic-images-10k
DATASET_LOCAL_PATH=./data/sample_recipes.json
DATASET_SAMPLE_SIZE=200
DATASET_IMAGES_DIR=./data/images

# --- Embeddings cache ------------------------------------------------------
EMBEDDINGS_CACHE_PATH=./data/embeddings.safetensors
EMBEDDINGS_DIM=2048
EMBEDDING_BATCH_SIZE=16

# --- RAG pipeline ----------------------------------------------------------
DEFAULT_TOP_K=5
RERANK_TOP_K=20
GENERATE_MAX_NEW_TOKENS=512
GENERATE_TEMPERATURE=0.7

# --- Reliability -----------------------------------------------------------
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=60

# --- Cache (in-memory LRU) -------------------------------------------------
CACHE_ENABLED=true
CACHE_MAX_SIZE=1024

# --- Monitoring ------------------------------------------------------------
ENABLE_METRICS=true
PROMETHEUS_MULTIPROC_DIR=./data/prometheus

# --- Security --------------------------------------------------------------
API_KEY=                        # if set, clients must send `X-API-Key` header
CORS_ORIGINS=*                  # comma-separated list, or `*`
